FROM alpine AS builder

RUN apk add --no-cache build-base cmake curl git json-c-dev libwebsockets-dev \
    libuv-dev openssl-dev linux-headers \
    nodejs npm

WORKDIR /src
COPY . .

# Build frontend (html -> src/html.h)
RUN npm install -g yarn \
    && cd html && yarn install && yarn run build

# Build ttyd binary
RUN mkdir -p build && cd build \
    && cmake -DCMAKE_BUILD_TYPE=RELEASE .. \
    && make -j$(nproc)

FROM alpine
RUN apk add --no-cache bash tini
COPY --from=builder /src/build/ttyd /usr/bin/ttyd

EXPOSE 7681
WORKDIR /root
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["ttyd", "-W", "bash"]
